<?xml version="1.0" encoding="utf-8"?>
<!-- PLAN.md Phase 10.6: declares this app as a media app for Android Auto.
     Required alongside the MediaBrowserService intent-filter in
     AndroidManifest.xml (added when audio_service was first set up in
     Phase 5): that filter alone lets any Bluetooth/media client browse,
     but Android Auto specifically checks for this file before listing the
     app as a car-usable media source. -->
<automotiveApp>
    <uses name="media"/>
</automotiveApp>
